# evulMedia instance: "media" — copy to env/media.env and edit.
# systemd unit: evulmedia@media.service  (instance name = file basename)

MB_ROOT=/srv/media/public
MB_NAME=Media
MB_PORT=7081
MB_THUMBS=/opt/evulmedia/data/thumbs/public
MB_SLOTS_DIR=/opt/evulmedia/data/slots
MB_REMUX_DIR=/opt/evulmedia/data/remux

# openssl rand -hex 32
MB_SECRET=change-me

# --- optional tuning (defaults shown) ---
# MB_SCAN_INTERVAL=300
# MB_REMUX_MAX_GB=50
# MB_REMUX_MAX_AGE_DAYS=14
# MB_THUMB_MAX_GB=2
# MB_THUMB_MAX_AGE_DAYS=30
# MB_MAX_TRANSCODES=2
# MB_STALL_TIMEOUT=300

# evulMedia instance: "private" — copy to env/private.env and edit.
# Protect the matching hostname with basic_auth (or better) in Caddy;
# the app itself has NO authentication.

MB_ROOT=/srv/media/private
MB_NAME=Private
MB_PORT=7082
MB_THUMBS=/opt/evulmedia/data/thumbs/private
MB_SLOTS_DIR=/opt/evulmedia/data/slots
MB_REMUX_DIR=/opt/evulmedia/data/remux

# openssl rand -hex 32  (use a DIFFERENT secret than other instances)
MB_SECRET=change-me

# --- optional tuning (defaults shown) ---
# MB_SCAN_INTERVAL=300
# MB_REMUX_MAX_GB=50
# MB_REMUX_MAX_AGE_DAYS=14
# MB_THUMB_MAX_GB=2
# MB_THUMB_MAX_AGE_DAYS=30
# MB_MAX_TRANSCODES=2
# MB_STALL_TIMEOUT=300
